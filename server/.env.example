# VisionForge AI Server Environment Configuration
# API Credentials must remain SERVER-SIDE ONLY in server/.env
# Never commit actual tokens to GitHub or expose them to client JavaScript.

PORT=3001

# Cloudflare Workers AI Credentials (Primary Provider)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Hugging Face Access Token (Reference/Fallback Adapter)
HF_TOKEN=your_huggingface_token_here
